<?xml version="1.0"?>
<!-- ros2_control interfaces for the 6 arm joints (Gazebo Sim system). -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="arm_ros2_control" params="name:=RobotSystem plugin:=gz_ros2_control/GazeboSimSystem">
    <ros2_control name="${name}" type="system">
      <hardware>
        <plugin>${plugin}</plugin>
      </hardware>
      <xacro:macro name="pos_joint" params="joint">
        <joint name="${joint}">
          <command_interface name="position"/>
          <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
          <state_interface name="velocity"/>
        </joint>
      </xacro:macro>
      <xacro:pos_joint joint="Joint0"/>
      <xacro:pos_joint joint="Joint1"/>
      <xacro:pos_joint joint="Joint2"/>
      <xacro:pos_joint joint="Joint3"/>
      <xacro:pos_joint joint="Joint4"/>
      <xacro:pos_joint joint="Joint5"/>
    </ros2_control>
  </xacro:macro>
</robot>
