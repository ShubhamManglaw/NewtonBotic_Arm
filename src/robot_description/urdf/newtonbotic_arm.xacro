<?xml version="1.0"?>
<!--
  NewtonBotic 6-DOF arm: links and joints.

  Kinematics (joint origins / axes / limits) are the SolidWorks export values,
  unchanged. Only the base frame was re-origined (see docs/PROJECT_AUDIT.md §7.1):
  base_link now sits on the floor directly below the Joint0 (base yaw) axis.
  The base CAD mesh is offset inside its file, so that offset lives in the
  base visual/collision <origin> instead of a cancelling world/Joint0 pair.

  Visual geometry = full CAD STL. Collision geometry = convex hulls generated by
  tools/make_collision_meshes.py (same link frame as the visual mesh).
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="mesh_dir" value="package://robot_description/meshes"/>
  <xacro:property name="base_mesh_offset" value="-0.58819 1.3556 -0.7833"/>

  <material name="light_gray"><color rgba="0.894 0.894 0.894 1"/></material>
  <material name="dark_gray"><color rgba="0.627 0.627 0.627 1"/></material>

  <xacro:macro name="cad_link" params="name mass com ixx ixy ixz iyy iyz izz material:=light_gray mesh_origin:='0 0 0'">
    <link name="${name}">
      <inertial>
        <origin xyz="${com}" rpy="0 0 0"/>
        <mass value="${mass}"/>
        <inertia ixx="${ixx}" ixy="${ixy}" ixz="${ixz}" iyy="${iyy}" iyz="${iyz}" izz="${izz}"/>
      </inertial>
      <visual>
        <origin xyz="${mesh_origin}" rpy="0 0 0"/>
        <geometry><mesh filename="${mesh_dir}/${name}.STL"/></geometry>
        <material name="${material}"/>
      </visual>
      <collision>
        <origin xyz="${mesh_origin}" rpy="0 0 0"/>
        <geometry><mesh filename="${mesh_dir}/collision/${name}.stl"/></geometry>
      </collision>
    </link>
  </xacro:macro>

  <xacro:macro name="newtonbotic_arm" params="parent:=world *origin">

    <joint name="world_to_base" type="fixed">
      <parent link="${parent}"/>
      <child link="base_link"/>
      <xacro:insert_block name="origin"/>
    </joint>

    <!-- Inertial re-expressed in the mesh frame (CAD export had it rotated 90deg about X) -->
    <xacro:cad_link name="base_link" mass="0.546341098415409"
      com="-0.00058 -0.03085 0.05115" mesh_origin="${base_mesh_offset}"
      ixx="0.00145370522662828" iyy="0.00082618609076026" izz="0.00192501053037935"
      ixy="-1.27685565017533E-05" ixz="5.03068618381143E-06" iyz="2.53038507022113E-05"/>

    <xacro:cad_link name="Link_1" mass="0.328794097435058"
      com="0.000723054985724891 0.0766927088795418 0.00240702908519452"
      ixx="0.00025603933216354" ixy="-2.6267141561338E-06" ixz="8.88939307036987E-06"
      iyy="0.000262198406382732" iyz="-4.6183040311036E-06" izz="0.000175926600668971"/>

    <xacro:cad_link name="Link_2" mass="0.454272401228299"
      com="-0.0695627924566193 2.92433703790174E-05 0.0770722987177986"
      ixx="0.00106646759996456" ixy="2.71085907939147E-07" ixz="4.32845745836285E-05"
      iyy="0.00106429175880337" iyz="-2.88100434056117E-07" izz="0.000273417464291462"/>

    <xacro:cad_link name="Link_3" mass="0.194144790001676"
      com="-0.00242355331676225 -0.00139316445814353 0.00626287395724856"
      ixx="0.000134935532280734" ixy="-2.28937636043339E-07" ixz="-7.22633964340457E-07"
      iyy="0.000139451129393382" iyz="4.23988758452318E-06" izz="0.000189362576950466"/>

    <xacro:cad_link name="Link_4" mass="0.364185793528403"
      com="0.0802868716169463 0.000175287565380988 -0.00177036120970642"
      ixx="0.000289171893216514" ixy="-1.25550681654366E-06" ixz="-2.8016202605502E-05"
      iyy="0.000656479608188458" iyz="5.86839416841618E-07" izz="0.000617314662671434"/>

    <xacro:cad_link name="Link_5" mass="0.0756369555731985"
      com="0.00111833770528924 0.00428268851831226 0.00580730411791597"
      ixx="4.67238601079906E-05" ixy="1.44252441765377E-07" ixz="6.38266027622581E-08"
      iyy="2.75860660360075E-05" iyz="-1.43846005911757E-07" izz="4.04690757285228E-05"/>

    <xacro:cad_link name="Link_6" mass="0.0389442702660889" material="dark_gray"
      com="1.45509937432564E-09 0.0172819546797272 -0.000173910195417237"
      ixx="7.21228823682369E-06" ixy="2.17125448246009E-13" ixz="-1.11016246056671E-12"
      iyy="1.11525127397258E-05" iyz="-3.77075922953793E-08" izz="7.32375634882094E-06"/>

    <!-- Base yaw. Was xyz="0.58819 -1.3556 0.82381" before base re-origin. -->
    <joint name="Joint0" type="revolute">
      <origin xyz="0 0 0.04051" rpy="1.5708 0 0.04219"/>
      <parent link="base_link"/>
      <child link="Link_1"/>
      <axis xyz="0 1 0"/>
      <limit lower="-3.1416" upper="3.1416" effort="100" velocity="2"/>
    </joint>

    <!-- Shoulder pitch -->
    <joint name="Joint1" type="revolute">
      <origin xyz="0 0.1045 -0.02" rpy="-1.5859 0 0"/>
      <parent link="Link_1"/>
      <child link="Link_2"/>
      <axis xyz="1 0 0"/>
      <limit lower="-1.5708" upper="1.5708" effort="80" velocity="2"/>
    </joint>

    <!-- Elbow pitch -->
    <joint name="Joint2" type="revolute">
      <origin xyz="0 0 0.2" rpy="1.4024 0 0"/>
      <parent link="Link_2"/>
      <child link="Link_3"/>
      <axis xyz="1 0 0"/>
      <limit lower="-2.618" upper="2.618" effort="60" velocity="2.5"/>
    </joint>

    <!-- Forearm roll -->
    <joint name="Joint3" type="revolute">
      <origin xyz="0 0 0" rpy="0.10657 1.5708 0"/>
      <parent link="Link_3"/>
      <child link="Link_4"/>
      <axis xyz="1 0 0"/>
      <limit lower="-3.1416" upper="3.1416" effort="40" velocity="3"/>
    </joint>

    <!-- Wrist pitch -->
    <joint name="Joint4" type="revolute">
      <origin xyz="0.177 0.00021252 0" rpy="-3.1416 0 -3.0274"/>
      <parent link="Link_4"/>
      <child link="Link_5"/>
      <axis xyz="0 0 1"/>
      <limit lower="-2.0944" upper="2.0944" effort="25" velocity="3.5"/>
    </joint>

    <!-- Tool roll -->
    <joint name="Joint5" type="revolute">
      <origin xyz="-0.027025 0 0.0019864" rpy="3.1416 1.4833 -1.5708"/>
      <parent link="Link_5"/>
      <child link="Link_6"/>
      <axis xyz="0 1 0"/>
      <limit lower="-6.2832" upper="6.2832" effort="15" velocity="4"/>
    </joint>

    <!--
      tool0: flange frame on the Link_6 mounting face (Link_6 mesh ends at
      y=0.029). Z points out of the flange along the Joint5 axis (REP-199 style).
      The gripper mounts to tool0.
    -->
    <link name="tool0"/>
    <joint name="Link_6_to_tool0" type="fixed">
      <parent link="Link_6"/>
      <child link="tool0"/>
      <origin xyz="0 0.029 0" rpy="-1.5708 0 0"/>
    </joint>

  </xacro:macro>
</robot>
