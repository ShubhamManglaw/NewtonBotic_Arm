    <!-- ===================================================== -->
    <!-- Tool Frame -->
    <!-- ===================================================== -->

    <link name="tool0">

        <visual>
            <origin xyz="0 0 0.02" rpy="0 0 0"/>
            <geometry>
                <sphere radius="0.015"/>
            </geometry>
            <material name="black"/>
        </visual>

        <collision>
            <origin xyz="0 0 0.02" rpy="0 0 0"/>
            <geometry>
                <sphere radius="0.015"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0 0 0.02" rpy="0 0 0"/>
            <mass value="0.1"/>
            <inertia
                ixx="0.0001"
                ixy="0.0"
                ixz="0.0"
