            <mass value="0.5"/>
            <inertia
                ixx="0.0005"
                ixy="0.0"
                ixz="0.0"
                iyy="0.0005"
                iyz="0.0"
                izz="0.0005"/>
        </inertial>

    </link>

    <!-- ===================================================== -->
    <!-- Link 5 : Wrist 2 -->
    <!-- ===================================================== -->

    <link name="link5">

        <visual>
            <origin xyz="0 0 0.035" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.025" length="0.07"/>
            </geometry>
            <material name="grey"/>
        </visual>

        <collision>
            <origin xyz="0 0 0.035" rpy="0 0 0"/>
            <geometry>
