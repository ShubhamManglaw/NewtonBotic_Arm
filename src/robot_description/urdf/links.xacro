<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- ===================================================== -->
    <!-- Base Link -->
    <!-- ===================================================== -->

    <link name="base_link">

        <visual>
            <origin xyz="0 0 0.05" rpy="0 0 0"/>
            <geometry>
                <box size="0.10 0.10 0.10"/>
            </geometry>
            <material name="blue"/>
        </visual>

        <collision>
            <origin xyz="0 0 0.05" rpy="0 0 0"/>
            <geometry>
                <box size="0.10 0.10 0.10"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0 0 0.05" rpy="0 0 0"/>
            <mass value="2.0"/>
            <inertia
                ixx="0.005"
                ixy="0.0"
                ixz="0.0"
                iyy="0.005"
                iyz="0.0"
                izz="0.005"/>
        </inertial>

    </link>

    <!-- ===================================================== -->
    <!-- Link 1 : Shoulder Support -->
    <!-- ===================================================== -->

    <link name="link1">

        <visual>
            <origin xyz="0 0 0.075" rpy="0 0 0"/>
            <geometry>
                <box size="0.08 0.08 0.15"/>
            </geometry>
            <material name="grey"/>
        </visual>

        <collision>
            <origin xyz="0 0 0.075" rpy="0 0 0"/>
            <geometry>
                <box size="0.08 0.08 0.15"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0 0 0.075" rpy="0 0 0"/>
            <mass value="1.5"/>
            <inertia
                ixx="0.002"
                ixy="0.0"
                ixz="0.0"
                iyy="0.002"
                iyz="0.0"
                izz="0.002"/>
        </inertial>

    </link>

    <!-- ===================================================== -->
    <!-- Link 2 : Upper Arm -->
    <!-- ===================================================== -->

    <link name="link2">

        <visual>
            <origin xyz="0.10 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.20 0.05 0.05"/>
            </geometry>
            <material name="grey"/>
        </visual>

        <collision>
            <origin xyz="0.10 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.20 0.05 0.05"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0.10 0 0" rpy="0 0 0"/>
            <mass value="1.2"/>
            <inertia
                ixx="0.002"
                ixy="0.0"
                ixz="0.0"
                iyy="0.002"
                iyz="0.0"
                izz="0.002"/>
        </inertial>

    </link>

    <!-- ===================================================== -->
    <!-- Link 3 : Forearm -->
    <!-- ===================================================== -->

    <link name="link3">

        <visual>
            <origin xyz="0.09 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.18 0.045 0.045"/>
            </geometry>
            <material name="grey"/>
        </visual>

        <collision>
            <origin xyz="0.09 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.18 0.045 0.045"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0.09 0 0" rpy="0 0 0"/>
            <mass value="1.0"/>
            <inertia
                ixx="0.0015"
                ixy="0.0"
                ixz="0.0"
                iyy="0.0015"
                iyz="0.0"
                izz="0.0015"/>
        </inertial>

    </link>

    <!-- ===================================================== -->
    <!-- Link 4 : Wrist 1 -->
    <!-- ===================================================== -->

    <link name="link4">

        <visual>
            <origin xyz="0 0 0.04" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="0.03" length="0.08"/>
            </geometry>
            <material name="grey"/>
        </visual>

        <collision>
            <origin xyz="0 0 0.04" rpy="0 0 0"/>
