<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robot_description">

  <!-- World link -->
  <link name="world"/>

  <!-- Fixed joint anchoring base_link flat on the ground at world origin (Z=0, X=0, Y=0) -->
  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="-0.58819 1.3556 -0.7833" rpy="0 0 0"/>
  </joint>

  <!-- base_link -->
  <link name="base_link">
    <inertial>
      <origin xyz="0.587606575850593 0.834452661665232 1.38645158884499" rpy="0 0 0" />
      <mass value="0.546341098415409" />
      <inertia
        ixx="0.00145370522662828"
        ixy="5.03068618381143E-06"
        ixz="1.27685565017533E-05"
        iyy="0.00192501053037935"
        iyz="-2.53038507022113E-05"
        izz="0.00082618609076026" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://robot_description/meshes/base_link.STL" />
      </geometry>
      <material name="light_gray">
        <color rgba="0.894117647058823 0.894117647058823 0.894117647058823 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://robot_description/meshes/base_link.STL" />
      </geometry>
    </collision>
  </link>

  <!-- Link_1 -->
  <link name="Link_1">
    <inertial>
      <origin xyz="0.000723054985724891 0.0766927088795418 0.00240702908519452" rpy="0 0 0" />
      <mass value="0.328794097435058" />
      <inertia
        ixx="0.00025603933216354"
        ixy="-2.6267141561338E-06"
        ixz="8.88939307036987E-06"
        iyy="0.000262198406382732"
        iyz="-4.6183040311036E-06"
        izz="0.000175926600668971" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://robot_description/meshes/Link_1.STL" />
      </geometry>
      <material name="light_gray">
        <color rgba="0.894117647058823 0.894117647058823 0.894117647058823 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://robot_description/meshes/Link_1.STL" />
      </geometry>
    </collision>
  </link>

  <!-- Joint0 -->
  <joint name="Joint0" type="revolute">
    <origin xyz="0.58819 -1.3556 0.82381" rpy="1.5708 0 0.04219" />
    <parent link="base_link" />
    <child link="Link_1" />
    <axis xyz="0 1 0" />
    <limit lower="-3.1416" upper="3.1416" effort="100" velocity="2" />
  </joint>

  <!-- Link_2 -->
  <link name="Link_2">
    <inertial>
      <origin xyz="-0.0695627924566193 2.92433703790174E-05 0.0770722987177986" rpy="0 0 0" />
      <mass value="0.454272401228299" />
      <inertia
        ixx="0.00106646759996456"
        ixy="2.71085907939147E-07"
        ixz="4.32845745836285E-05"
        iyy="0.00106429175880337"
        iyz="-2.88100434056117E-07"
        izz="0.000273417464291462" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://robot_description/meshes/Link_2.STL" />
      </geometry>
      <material name="light_gray">
        <color rgba="0.894117647058823 0.894117647058823 0.894117647058823 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://robot_description/meshes/Link_2.STL" />
      </geometry>
    </collision>
  </link>

  <!-- Joint1 -->
  <joint name="Joint1" type="revolute">
    <origin xyz="0 0.1045 -0.02" rpy="-1.5859 0 0" />
    <parent link="Link_1" />
    <child link="Link_2" />
    <axis xyz="1 0 0" />
    <limit lower="-1.5708" upper="1.5708" effort="80" velocity="2" />
  </joint>

  <!-- Link_3 -->
  <link name="Link_3">
    <inertial>
      <origin xyz="-0.00242355331676225 -0.00139316445814353 0.00626287395724856" rpy="0 0 0" />
      <mass value="0.194144790001676" />
      <inertia
        ixx="0.000134935532280734"
        ixy="-2.28937636043339E-07"
        ixz="-7.22633964340457E-07"
        iyy="0.000139451129393382"
        iyz="4.23988758452318E-06"
        izz="0.000189362576950466" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://robot_description/meshes/Link_3.STL" />
      </geometry>
      <material name="light_gray">
        <color rgba="0.894117647058823 0.894117647058823 0.894117647058823 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://robot_description/meshes/Link_3.STL" />
      </geometry>
    </collision>
  </link>

  <!-- Joint2 -->
  <joint name="Joint2" type="revolute">
    <origin xyz="0 0 0.2" rpy="1.4024 0 0" />
    <parent link="Link_2" />
    <child link="Link_3" />
    <axis xyz="1 0 0" />
    <limit lower="-2.618" upper="2.618" effort="60" velocity="2.5" />
  </joint>

  <!-- Link_4 -->
  <link name="Link_4">
    <inertial>
      <origin xyz="0.0802868716169463 0.000175287565380988 -0.00177036120970642" rpy="0 0 0" />
      <mass value="0.364185793528403" />
      <inertia
        ixx="0.000289171893216514"
        ixy="-1.25550681654366E-06"
        ixz="-2.8016202605502E-05"
        iyy="0.000656479608188458"
        iyz="5.86839416841618E-07"
        izz="0.000617314662671434" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://robot_description/meshes/Link_4.STL" />
      </geometry>
      <material name="light_gray">
        <color rgba="0.894117647058823 0.894117647058823 0.894117647058823 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://robot_description/meshes/Link_4.STL" />
      </geometry>
    </collision>
  </link>

  <!-- Joint3 -->
  <joint name="Joint3" type="revolute">
    <origin xyz="0 0 0" rpy="0.10657 1.5708 0" />
    <parent link="Link_3" />
    <child link="Link_4" />
    <axis xyz="1 0 0" />
    <limit lower="-3.1416" upper="3.1416" effort="40" velocity="3" />
  </joint>

  <!-- Link_5 -->
  <link name="Link_5">
    <inertial>
      <origin xyz="0.00111833770528924 0.00428268851831226 0.00580730411791597" rpy="0 0 0" />
      <mass value="0.0756369555731985" />
      <inertia
        ixx="4.67238601079906E-05"
        ixy="1.44252441765377E-07"
        ixz="6.38266027622581E-08"
        iyy="2.75860660360075E-05"
        iyz="-1.43846005911757E-07"
        izz="4.04690757285228E-05" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://robot_description/meshes/Link_5.STL" />
      </geometry>
      <material name="light_gray">
        <color rgba="0.894117647058823 0.894117647058823 0.894117647058823 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://robot_description/meshes/Link_5.STL" />
      </geometry>
    </collision>
  </link>

  <!-- Joint4 -->
  <joint name="Joint4" type="revolute">
    <origin xyz="0.177 0.00021252 0" rpy="-3.1416 0 -3.0274" />
    <parent link="Link_4" />
    <child link="Link_5" />
    <axis xyz="0 0 1" />
    <limit lower="-2.0944" upper="2.0944" effort="25" velocity="3.5" />
  </joint>

  <!-- Link_6 -->
  <link name="Link_6">
    <inertial>
      <origin xyz="1.45509937432564E-09 0.0172819546797272 -0.000173910195417237" rpy="0 0 0" />
      <mass value="0.0389442702660889" />
      <inertia
        ixx="7.21228823682369E-06"
        ixy="2.17125448246009E-13"
        ixz="-1.11016246056671E-12"
        iyy="1.11525127397258E-05"
        iyz="-3.77075922953793E-08"
        izz="7.32375634882094E-06" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://robot_description/meshes/Link_6.STL" />
      </geometry>
      <material name="dark_gray">
        <color rgba="0.627450980392157 0.627450980392157 0.627450980392157 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://robot_description/meshes/Link_6.STL" />
      </geometry>
    </collision>
  </link>

  <!-- Joint5 -->
  <joint name="Joint5" type="revolute">
    <origin xyz="-0.027025 0 0.0019864" rpy="3.1416 1.4833 -1.5708" />
    <parent link="Link_5" />
    <child link="Link_6" />
    <axis xyz="0 1 0" />
    <limit lower="-6.2832" upper="6.2832" effort="15" velocity="4" />
  </joint>


<ros2_control name="RobotSystem" type="system">

  <hardware>

    <plugin>
      gz_ros2_control/GazeboSimSystem
    </plugin>

  </hardware>


  <joint name="Joint0">

    <command_interface name="position"/>

    <state_interface name="position"/>

    <state_interface name="velocity"/>

  </joint>


  <joint name="Joint1">

    <command_interface name="position"/>

    <state_interface name="position"/>

    <state_interface name="velocity"/>

  </joint>


  <joint name="Joint2">

    <command_interface name="position"/>

    <state_interface name="position"/>

    <state_interface name="velocity"/>

  </joint>


  <joint name="Joint3">

    <command_interface name="position"/>

    <state_interface name="position"/>

    <state_interface name="velocity"/>

  </joint>


  <joint name="Joint4">

    <command_interface name="position"/>

    <state_interface name="position"/>

    <state_interface name="velocity"/>

  </joint>


  <joint name="Joint5">

    <command_interface name="position"/>

    <state_interface name="position"/>

    <state_interface name="velocity"/>

  </joint>


</ros2_control>



<gazebo>
  <plugin
    filename="gz_ros2_control-system"
    name="gz_ros2_control::GazeboSimROS2ControlPlugin">
   <parameters>$(find robot_bringup)/config/controllers.yaml</parameters>
  </plugin>
</gazebo>
</robot>