<?xml version="1.0"?>
<!--
  Entry point for the NewtonBotic arm description.

  Args:
    use_gazebo        include ros2_control + gz_ros2_control plugin (default true)
    controllers_file  controller YAML loaded by gz_ros2_control
    use_gripper       include the gripper (gripper.xacro, mounted on tool0).
                      Default false until the gripper CAD is integrated.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="newtonbotic_arm">

  <xacro:arg name="use_gazebo" default="true"/>
  <xacro:arg name="controllers_file" default="$(find robot_bringup)/config/controllers.yaml"/>
  <xacro:arg name="use_gripper" default="false"/>

  <xacro:include filename="$(find robot_description)/urdf/newtonbotic_arm.xacro"/>
  <xacro:include filename="$(find robot_description)/urdf/arm.ros2_control.xacro"/>
  <xacro:include filename="$(find robot_description)/urdf/arm.gazebo.xacro"/>

  <link name="world"/>

  <xacro:newtonbotic_arm parent="world">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:newtonbotic_arm>

  <xacro:if value="$(arg use_gripper)">
    <xacro:include filename="$(find robot_description)/urdf/gripper.xacro"/>
    <xacro:gripper parent="tool0"/>
  </xacro:if>

  <xacro:if value="$(arg use_gazebo)">
    <xacro:arm_ros2_control/>
    <xacro:arm_gazebo controllers_file="$(arg controllers_file)"/>
  </xacro:if>

</robot>
