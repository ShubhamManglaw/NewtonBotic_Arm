<?xml version="1.0"?>
<!-- Gazebo Sim (Harmonic) plugin that hosts the ros2_control controller manager. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="arm_gazebo" params="controllers_file">
    <gazebo>
      <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>${controllers_file}</parameters>
      </plugin>
    </gazebo>
  </xacro:macro>
</robot>
