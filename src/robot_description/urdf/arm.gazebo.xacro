<?xml version="1.0"?>
<!-- Gazebo Sim (Harmonic): ros2_control plugin + gripper pad contact properties. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="arm_gazebo" params="controllers_file">
    <gazebo>
      <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>${controllers_file}</parameters>
      </plugin>
    </gazebo>

    <!-- Pure-friction grasping: high-friction, stiff finger contacts
         (values from helene_description's reference helene.urdf.xacro). -->
    <xacro:macro name="pad_contact" params="link">
      <gazebo reference="${link}">
        <mu1>2.0</mu1>
        <mu2>2.0</mu2>
        <kp>1.0e5</kp>
        <kd>10.0</kd>
        <minDepth>0.0005</minDepth>
        <maxVel>0.01</maxVel>
      </gazebo>
    </xacro:macro>
    <xacro:pad_contact link="finger_r"/>
    <xacro:pad_contact link="finger_l"/>
  </xacro:macro>
</robot>
