<?xml version="1.0"?>
<package format="3">
  <name>chess_manipulation</name>
  <version>1.0.0</version>
  <description>Pick-and-place primitives for chess pieces using MoveIt 2 (no chess rules here).</description>
  <maintainer email="Shubhammanglaw@gmail.com">Shubham</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>shape_msgs</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>chess_simulation</exec_depend>
  <exec_depend>chess_interfaces</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
