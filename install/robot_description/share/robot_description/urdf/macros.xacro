<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="mesh_link"
                 params="
                    name
                    mesh
                    mass
                    ixx iyy izz
                    ixy:=0
                    ixz:=0
                    iyz:=0
                    ">
        <link name="${name}">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="file:///home/shubham/robot_arm_ws/src/robot_description/meshes/${mesh}"
                    scale="1 1 1"/>
                </geometry>
                <material name="grey"/>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>

                <geometry>
                    <mesh filename="file:///home/shubham/robot_arm_ws/src/robot_description/meshes/${mesh}"
                        scale="1 1 1"/>
                </geometry>
            </collision>
            
            <inertial>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <mass value="${mass}"/>
                <inertia ixx="${ixx}" iyy="${iyy}" izz="${izz}"
                ixy="${ixy}" ixz="${ixz}" iyz="${iyz}"/>
            </inertial>
            
        </link>
    </xacro:macro>
</robot>